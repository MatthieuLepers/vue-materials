{
  "name": "vue-materials",
  "version": "1.0.0",
  "author": "Matthieu LEPERS",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "src/assets/styles",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/components.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./utils": {
      "types": "./dist/types/utils/index.d.ts",
      "import": "./dist/utils.js"
    },
    "./composables": {
      "types": "./dist/types/composables/index.d.ts",
      "import": "./dist/composables.js"
    },
    "./directives": {
      "types": "./dist/types/directives/index.d.ts",
      "import": "./dist/directives.js"
    },
    "./plugins": {
      "types": "./dist/types/plugins/index.d.ts",
      "import": "./dist/plugins.js"
    },
    "./i18n": {
      "types": "./dist/types/i18n/index.d.ts",
      "import": "./dist/i18n.js"
    },
    "./styles": "./dist/styles.css",
    "./utilities.scss": "./src/assets/styles/utilities.scss"
  },
  "scripts": {
    "lint": "eslint ./src --ext .js,.ts,.vue --fix",
    "type-check": "vue-tsc --noEmit",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build": "npm run type-check && npm run build:types && vite build",
    "prepare": "npm run build",
    "dev": "vite",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "vue-draggable-next": "^2.3.0",
    "vue-i18n": "^11.4.5"
  },
  "peerDependencies": {
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "^10.6.2",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^9.33.0",
    "sass": "^1.99.0",
    "storybook": "^10.6.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.16",
    "vue": "^3.5.35",
    "vue-component-meta": "^3.3.9",
    "vue-tsc": "^3.2.6",
    "@storybook/addon-docs": "^10.6.2"
  },
  "overrides": {
    "vite": {
      "rolldown": "1.0.1"
    }
  }
}
